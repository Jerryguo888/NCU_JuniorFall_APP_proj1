rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validItem(d, id) {
      return d.keys().hasAll(['id', 'kind', 'title', 'date', 'category', 'notes', 'completed', 'demo', 'updatedAt'])
        && d.keys().hasOnly(['id', 'kind', 'title', 'date', 'category', 'notes', 'completed', 'demo', 'updatedAt', 'start', 'end', 'location', 'priority'])
        && d.id == id && id.matches('^[a-zA-Z0-9_-]{1,100}$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.notes is string && d.notes.size() <= 1000
        && d.date is string && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.category in ['study', 'work', 'life', 'personal']
        && d.completed is bool && d.demo is bool
        && d.updatedAt is number && d.updatedAt >= 0
        && ((d.kind == 'task' && d.priority in ['high', 'medium', 'low']
              && !d.keys().hasAny(['start', 'end', 'location']))
          || (d.kind == 'event' && !d.keys().hasAny(['priority'])
              && d.start is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
              && d.end is string && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
              && d.end > d.start && d.location is string && d.location.size() <= 120));
    }
    match /users/{uid}/items/{itemId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validItem(request.resource.data, itemId);
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
